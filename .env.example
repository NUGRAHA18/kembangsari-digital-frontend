# Berkas ini untuk pengembangan di komputer sendiri: salin menjadi `.env.local`.
#
# Di production nilainya TIDAK diambil dari sini melainkan dari Environment
# Variables di dashboard Vercel, dan dibaca saat build — mengubahnya di sana
# baru berlaku setelah Redeploy. Lihat DEPLOY.md.

# Base URL backend. Ganti baris ini saat backend pindah ke Render/Railway —
# tidak ada base URL lain yang ditulis di dalam kode.
#
# WAJIB berakhiran /api/v1 dan tanpa garis miring di ujung. Salah satu saja
# meleset, setiap permintaan dijawab 404.
#
# Satu-satunya variabel yang WAJIB ada: `lib/api.ts` melempar galat saat dimuat
# kalau kosong, dan build ikut gagal di /sitemap.xml.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Alamat frontend sendiri. Dipakai untuk URL absolut pada tag Open Graph,
# sitemap.xml, robots.txt, dan QR Code monografi.
#
# Boleh dikosongkan — nilai cadangannya http://localhost:3001. Di production ia
# wajib diisi domain sungguhan, kalau tidak QR yang dicetak dan ditempel di
# balai padukuhan akan menunjuk localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
